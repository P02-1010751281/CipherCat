{
  "name": "ciphercat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CipherCat - A visual cryptography programming platform based on Blockly and Vue 3, supporting JavaScript, Python, and Kasm51 code generation",
  "author": "",
  "license": "MIT",
  "keywords": [
    "blockly",
    "cryptography",
    "visual-programming",
    "vue3",
    "sm4",
    "ecc",
    "code-generator",
    "education",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/P02-1010751281/CipherCat"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx",
    "docs:check-links": "node scripts/check-doc-links.mjs",
    "standards:check": "node scripts/check-standard-metadata.mjs",
    "standards:split-check": "node scripts/check-standard-split.mjs",
    "standards:formula-check": "node scripts/check-standard-formulas.mjs",
    "standards:inventory": "node scripts/check-standard-inventory.mjs --check",
    "standards:inventory:write": "node scripts/check-standard-inventory.mjs --write",
    "standards:repair-splits": "node scripts/repair-standard-entry-splits.mjs --write",
    "standards:repair-formulas": "node scripts/repair-standard-formula-sections.mjs --write",
    "cycles:check": "depcruise --config .dependency-cruiser.cjs --output-type err-long src",
    "build:check-bundle": "node scripts/check-bundle-budget.mjs",
    "verify:build": "vite build --config vite.verify.config.ts",
    "verify:templates": "npm run verify:build && node dist-verify/verify-templates.js",
    "verify:demos": "node scripts/verify-demos.mjs",
    "verify:all": "npm run standards:check && npm run standards:split-check && npm run standards:formula-check && npm run standards:inventory && npm run docs:check-links && npm run verify:build && node dist-verify/verify-templates.js && npm run verify:demos",
    "tauri": "tauri",
    "tauri:dev": "WEBKIT_DISABLE_COMPOSITING_MODE=1 tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@types/dompurify": "^3.0.5",
    "blockly": "13.2.0",
    "dompurify": "^3.4.12",
    "element-plus": "^2.14.1",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "vue": "^3.5.0",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "dependency-cruiser": "^18.4.0",
    "jsdom": "^29.1.1",
    "terser": "^5.46.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.14",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
